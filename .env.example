# ─────────────────────────────────────────────────────────────────────────────
# Root server-side environment (api/, server/, scripts/). SERVER ONLY.
# Copy to `.env` (gitignored) or set in the host's secret manager.
# NEVER prefix any of these with VITE_ — Vite inlines VITE_* into the browser
# bundle, which is exactly how a server key becomes public.
# Leave a value empty to keep the dependent feature disabled (fail closed).
# ─────────────────────────────────────────────────────────────────────────────

# Legacy Apps Script intake connector (server-to-server only)
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_INTAKE_SECRET=

# Phase 3 intake: opt in only after staging and source-binding provisioning
INTAKE_PROVIDER=apps-script
INTAKE_ENVIRONMENT=staging
ALLOW_INTAKE_NETWORK=false
RDS_INTAKE_ENABLED=false
INTAKE_SOURCE_TOKEN=
MAKE_INTAKE_ENABLED=false
MAKE_INTAKE_TOKEN=

# Supabase (service role bypasses RLS: server-only, never shipped to clients)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Make.com processing bridge
MAKE_PROCESSING_ENABLED=false
MAKE_PROCESSING_TOKEN=
MAKE_RECEIPT_SECRET=

# Processing worker
PROCESSING_ENVIRONMENT=staging
PROCESSING_PROVIDER=
ALLOW_PROCESSING_NETWORK=false
PROCESSING_ENDPOINT=
PROCESSING_ALLOWED_HOST=
PROCESSING_TOKEN=

# Gemini — rotate immediately if this value is ever pasted into a chat, a Make
# blueprint export, a Sheet, a log line or a commit. Restrict the key to the
# Generative Language API in Google Cloud Console.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DATA_APPROVAL=synthetic-only
GEMINI_PAID_PROJECT_APPROVED=false
