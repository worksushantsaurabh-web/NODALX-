# n8n owns the Airtable connection. Keep the Airtable token and n8n URLs out of the frontend.
N8N_INQUIRY_WEBHOOK_URL=https://your-n8n-host/webhook/flowpilot-inquiry
N8N_CUSTOMERS_WEBHOOK_URL=https://your-n8n-host/webhook/flowpilot-customers
N8N_FLOW_TEST_WEBHOOK_URL=https://your-n8n-host/webhook/flowpilot-test

# Optional: configure this only if your n8n webhook expects a bearer token.
N8N_WEBHOOK_AUTH_TOKEN=
N8N_REQUEST_TIMEOUT_MS=10000
