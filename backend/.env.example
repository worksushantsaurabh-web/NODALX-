# Server configuration
NODALX_OWNER_UID=your-firebase-auth-uid
MAKE_WEBHOOK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_GROWTH_PLAN_ID=
API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5001
API_PAYLOAD_MAX_SIZE=7mb

# Firebase Project ID (uses Application Default Credentials)
# Run: gcloud auth application-default login
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Cloud Project Configuration
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-project-id

# Proxy header for Vertex AI
PROXY_HEADER=your-random-proxy-header

# HubSpot CRM Integration (optional)
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
# Paid local proxy is disabled unless explicitly opted in. Leave disabled during billing dispute.
ENABLE_VERTEX_PROXY=false
ENABLE_VERTEX_LIVE_PROXY=false
# Explicit comma-separated Gemini model IDs; empty denies all models.
VERTEX_ALLOWED_MODELS=
