VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_APP_HOST=https://nodalx.in
# Leave empty for Firebase Hosting rewrites or the local Vite proxy.
VITE_API_BASE_URL=

# Optional development URL for server-side integration examples and test requests.
# Leave empty to use the local Vite /api proxy during development.
VITE_PUBLIC_API_ORIGIN=

# Deployed Cloud Run inquiry intake endpoint. Customers paste this into their
# integration snippets; server-side code and CI should prefer the unprefixed
# name so the bundle never embeds it.
PUBLIC_INQUIRY_API_URL=https://api-iwi2dxqnoa-uc.a.run.app

# Optional Google Apps Script webhook for external inquiry intake.
# NOTE: this endpoint requires INTAKE_SECRET on every request. Never put the
# secret in a VITE_ variable — those are compiled into the public JS bundle and
# would defeat the guard. Public forms must post through the authenticated
# /api/contact intake instead. Use VITE_APPSCRIPT_WEBHOOK_URL for server-side
# examples only.
VITE_APPSCRIPT_WEBHOOK_URL=
