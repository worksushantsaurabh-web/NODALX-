VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_APP_HOST=https://your-project.web.app
VITE_API_BASE_URL=https://your-cloud-run-url.run.app

# Optional: Google Apps Script webhook URL for live inquiry data in the dashboard.
# If unset, the dashboard will fall back to backend API data only.
VITE_APPSCRIPT_WEBHOOK_URL=
