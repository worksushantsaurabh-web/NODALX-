# Cloud Functions runtime environment.
# Copy to functions/.env for local emulation. Never commit the filled file.

# Make.com scenario URL that classifies each inbound inquiry.
MAKE_WEBHOOK_URL=

# Per-request timeout for outbound webhook calls, in milliseconds.
WEBHOOK_TIMEOUT_MS=30000

# Inquiry intake quotas. Defaults shown.
# INQUIRY_RATE_MAX is requests per window per API key. Per-IP ceilings are
# derived from it (5x authenticated, 10x pre-authentication).
INQUIRY_RATE_MAX=120
INQUIRY_RATE_WINDOW_MS=60000

# UID that receives site contact-form submissions.
NODALX_OWNER_UID=

# Razorpay subscriptions. Keep these on the server; never expose them as VITE_ variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_GROWTH_PLAN_ID=
